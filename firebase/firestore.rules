rules_version = '2';

// Public clients (website, app, Cloudflare Worker) are READ-ONLY.
// Writes come from the backend's service account (Admin SDK bypasses these rules) and from
// the site owner, signed in to /admin with their verified Google account.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'imanilchauhan3@gmail.com';
    }

    match /deals/{asin} {
      allow get: if true;
      // Public queries: max 500 at a time (live deals, and recently ended ones the site keeps for
      // 30 days). Every deal is already readable one by one, so listing exposes nothing new.
      allow list: if request.query.limit <= 500 || isOwner();
      allow create, update, delete: if isOwner();
    }

    // Post-id -> deal link lookups for the comment-to-DM worker.
    // Single-document reads only, no listing/enumeration.
    match /ig_media/{mediaId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /fb_posts/{postId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
