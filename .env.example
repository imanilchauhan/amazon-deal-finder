# Copy to backend/.env for local runs:  set -a; source .env; set +a; python -m deal_finder
# In GitHub: Settings → Secrets and variables → Actions. "secret" = Secret, "var" = Variable.

# --- Amazon ---------------------------------------------------------------
AMAZON_MARKETPLACE=in                 # var: in | com
AMAZON_ASSOCIATE_TAG=cartcrush004-21       # var (public in every link)
MAX_PRODUCTS=15                       # var: deals kept per run
MIN_DISCOUNT_PCT=20                   # var
MAX_POSTS_PER_RUN=3                   # var: deals pushed to social per run (all platforms)
DM_KEYWORD=DEAL                       # var: must match the Worker's KEYWORD
DRY_RUN=true                          # scrape + validate only

# --- Firebase (Spark / free plan) -----------------------------------------
FIREBASE_PROJECT_ID=                  # var
# In CI, auth is keyless (vars GCP_WIF_PROVIDER + GCP_SERVICE_ACCOUNT). Locally, either run
# `gcloud auth application-default login` or set a service-account key JSON (raw or base64):
FIREBASE_SERVICE_ACCOUNT_JSON=        # secret, optional

# --- X / Twitter ----------------------------------------------------------
X_ENABLED=false                       # var
X_PUBLISHER=buffer                    # var: buffer (free) | api (X API, $0.20 per link post)
BUFFER_API_KEY=                       # secret: publish.buffer.com/settings/api
BUFFER_CHANNEL_ID=                    # var: id of the connected X channel in Buffer
# Zernio (free: 2 accounts, unlimited posts). Facebook + Instagram go here first, Buffer is the backup.
ZERNIO_API_KEY=                       # secret: zernio.com dashboard -> API keys
ZERNIO_FB_ACCOUNT_ID=                 # var: run `python -m deal_finder.zernio` to list ids
ZERNIO_IG_ACCOUNT_ID=                 # var
REELS_ENABLED=true                    # var: FB + IG post an 8 s deal video as a Reel (photo card if it fails)
REEL_SECONDS=8
X_MAX_POSTS_PER_RUN=2                 # var
X_API_KEY=                            # secret
X_API_SECRET=                         # secret
X_ACCESS_TOKEN=                       # secret (needs Read+Write app permission)
X_ACCESS_TOKEN_SECRET=                # secret

# --- Meta (Facebook Page + Instagram professional account) ----------------
META_ENABLED=false                    # var
META_PAGE_ID=                         # secret
META_IG_USER_ID=                      # secret (IG business account id, not the @handle)
META_PAGE_ACCESS_TOKEN=               # secret (long-lived Page token)
META_GRAPH_VERSION=v26.0              # var
IG_POST_MODE=reel                     # var: reel | image | off
FB_POST_MODE=photo                    # var: photo | video | off
